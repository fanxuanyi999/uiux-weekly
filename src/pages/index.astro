---
import Shell from '../layouts/Shell.astro'
import Edition from '../components/Edition.astro'
import { base, issues } from '../lib/issues.mjs'
---
<Shell>
  <div class="reading feed">
    <header class="masthead"><h1>设计与产品周报</h1></header>
    {issues.map(issue => <Edition issue={issue} feed />)}
  </div>
  <a id="archive" class="reading legacy-anchor" href={base + '/archive/'}>查看往期归档</a>
</Shell>
