---
import Shell from '../layouts/Shell.astro'
import { issues, tags, issueUrl, formatDate } from '../lib/issues.mjs'
const [latest] = issues
---
<Shell>
  <section class="wrap hero" aria-labelledby="latest-title">
    <div class="hero-copy">
      <p class="eyebrow">最新一期 <time datetime={latest.date}>{formatDate(latest.date)}</time></p>
      <h1 id="latest-title">{latest.title}</h1>
      <p class="intro">{latest.summary}</p>
      <a class="button" href={issueUrl(latest.date)}>阅读本期</a>
    </div>
    <div class="cover" aria-hidden="true"><span></span><span></span><span></span><span></span><i></i></div>
  </section>
  <section id="archive" class="wrap archive" aria-labelledby="archive-title">
    <div class="section-head"><h2 id="archive-title">往期归档</h2><p id="result-count" aria-live="polite">共 {issues.length} 期</p></div>
    <div class="controls" hidden>
      <label class="search-label" for="search"><span aria-hidden="true">⌕</span><input id="search" type="search" aria-label="搜索周报" placeholder="搜索标题、正文或来源" /></label>
      <label class="topic-label">主题<select id="topic"><option value="">全部主题</option>{tags.map(tag => <option>{tag}</option>)}</select></label>
    </div>
    <div class="issue-list">
      {issues.map(issue => <article class="issue-card" data-tags={JSON.stringify(issue.tags)} data-search={JSON.stringify(issue).toLowerCase()}>
        <a href={issueUrl(issue.date)}>
          <time datetime={issue.date}>{formatDate(issue.date)}</time>
          <div><h3>{issue.title}</h3><p>{issue.summary}</p>
          <ul class="tags" aria-label="主题">{issue.tags.map(tag => <li>{tag}</li>)}</ul></div>
          <span class="read-label">阅读</span>
        </a>
      </article>)}
    </div>
    <p id="empty" class="empty" hidden>没有找到符合条件的周报。试试减少关键词或切换主题。</p>
  </section>
</Shell>
<script>
  const controls = document.querySelector<HTMLDivElement>('.controls')!
  const search = document.querySelector<HTMLInputElement>('#search')!
  const topic = document.querySelector<HTMLSelectElement>('#topic')!
  const count = document.querySelector('#result-count')!
  const empty = document.querySelector<HTMLElement>('#empty')!
  const cards = [...document.querySelectorAll<HTMLElement>('.issue-card')]
  function filter() {
    const words = search.value.toLowerCase().trim().split(/\s+/).filter(Boolean)
    let visible = 0
    for (const card of cards) {
      const matchesText = words.every(word => card.dataset.search!.includes(word))
      const matchesTopic = !topic.value || JSON.parse(card.dataset.tags!).includes(topic.value)
      card.hidden = !(matchesText && matchesTopic)
      if (!card.hidden) visible++
    }
    count.textContent = '共 ' + visible + ' 期'
    empty.hidden = visible > 0
  }
  controls.hidden = false
  search.addEventListener('input', filter)
  topic.addEventListener('change', filter)
  filter()
</script>
