---
import { base } from '../lib/issues.mjs'
import '../styles/site.css'
const { title = '快爆 UI/UX 周报', description = '每周追踪设计与产品实践。', section = '' } = Astro.props
---
<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#ffffff" />
  <link rel="icon" href="data:," />
  <title>{title}</title>
</head>
<body>
  <a class="skip" href="#main">跳到正文</a>
  <header class="top">
    <nav class="nav frame" aria-label="主导航">
      <a class="brand" href={base + '/'}>快爆 <span>UI/UX 周报</span></a>
      <a class="nav-link" href={base + '/archive/'} aria-current={section === 'archive' ? 'page' : undefined}>往期归档</a>
    </nav>
  </header>
  <main id="main"><slot /></main>
  <footer class="footer"><div class="frame">
    <a href={base + '/'}>快爆 UI/UX 周报</a><a href={base + '/archive/'}>往期归档</a>
  </div></footer>
</body>
</html>
